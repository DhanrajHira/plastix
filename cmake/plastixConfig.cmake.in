@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# CCCL / CUDAToolkit are linked PUBLICly only when plastix was built with CUDA
if(@PLASTIX_ENABLE_CUDA@)
    find_dependency(CUDAToolkit)
    find_dependency(CCCL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/plastixTargets.cmake")

check_required_components(plastix)
