@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# CCCL / CUDAToolkit are linked PUBLICly only when plastix was built with CUDA
if(@PLASTIX_ENABLE_CUDA@)
    find_dependency(CUDAToolkit)
    find_dependency(CCCL)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/plastixTargets.cmake")

# Re-export the helper that flips a consumer target's .cpp sources to CUDA (same
# as the in-tree definition) so out-of-tree consumers (e.g. Python bindings that
# instantiate Network<Traits>) can compile their shim as CUDA. Guarded so an
# in-tree build that already defines it is untouched.
if(NOT COMMAND plastix_enable_cuda_on_target)
    function(plastix_enable_cuda_on_target target)
        if(NOT PLASTIX_ENABLE_CUDA)
            return()
        endif()
        get_target_property(target_sources_list ${target} SOURCES)
        foreach(src ${target_sources_list})
            get_filename_component(src_ext ${src} EXT)
            if(src_ext STREQUAL ".cpp")
                set_source_files_properties(${src} TARGET_DIRECTORY ${target}
                                            PROPERTIES LANGUAGE CUDA)
            endif()
        endforeach()
        target_compile_options(${target} PRIVATE
            $<$<COMPILE_LANGUAGE:CUDA>:--extended-lambda>
            $<$<COMPILE_LANGUAGE:CUDA>:--expt-relaxed-constexpr>)
        set_target_properties(${target} PROPERTIES
            CUDA_SEPARABLE_COMPILATION ON
            CUDA_RESOLVE_DEVICE_SYMBOLS ON
            CUDA_ARCHITECTURES "${CMAKE_CUDA_ARCHITECTURES}")
    endfunction()
endif()

check_required_components(plastix)
